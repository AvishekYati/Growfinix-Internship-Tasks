    "# ============================================================\n",
    "# RULE-BASED SCENE ANALYSIS\n",
    "# ============================================================\n",
    "\n",
    "OUTDOOR_OBJECTS = {\n",
    "    \"car\",\n",
    "    \"truck\",\n",
    "    \"bus\",\n",
    "    \"motorcycle\",\n",
    "    \"bicycle\",\n",
    "    \"traffic light\",\n",
    "    \"stop sign\",\n",
    "    \"boat\",\n",
    "    \"airplane\",\n",
    "    \"train\",\n",
    "    \"horse\",\n",
    "    \"cow\",\n",
    "    \"sheep\",\n",
    "    \"dog\",\n",
    "    \"cat\",\n",
    "    \"bird\"\n",
    "}\n",
    "\n",
    "INDOOR_OBJECTS = {\n",
    "    \"chair\",\n",
    "    \"couch\",\n",
    "    \"bed\",\n",
    "    \"dining table\",\n",
    "    \"laptop\",\n",
    "    \"keyboard\",\n",
    "    \"mouse\",\n",
    "    \"tv\",\n",
    "    \"refrigerator\",\n",
    "    \"microwave\",\n",
    "    \"oven\",\n",
    "    \"sink\"\n",
    "}\n",
    "\n",
    "\n",
    "def classify_scene(detections):\n",
    "\n",
    "    object_names = [\n",
    "        d[\"object\"]\n",
    "        for d in detections\n",
    "    ]\n",
    "\n",
    "    outdoor_score = sum(\n",
    "        1 for obj in object_names\n",
    "        if obj in OUTDOOR_OBJECTS\n",
    "    )\n",
    "\n",
    "    indoor_score = sum(\n",
    "        1 for obj in object_names\n",
    "        if obj in INDOOR_OBJECTS\n",
    "    )\n",
    "\n",
    "    if outdoor_score > indoor_score:\n",
    "        environment = \"Outdoor\"\n",
    "\n",
    "    elif indoor_score > outdoor_score:\n",
    "        environment = \"Indoor\"\n",
    "\n",
    "    else:\n",
    "        environment = \"General\"\n",
    "\n",
    "    if any(\n",
    "        obj in {\n",
    "            \"car\",\n",
    "            \"truck\",\n",
    "            \"bus\",\n",
    "            \"motorcycle\",\n",
    "            \"bicycle\"\n",
    "        }\n",
    "        for obj in object_names\n",
    "    ):\n",
    "        scene_type = \"Transportation\"\n",
    "\n",
    "    elif any(\n",
    "        obj in {\n",
    "            \"person\",\n",
    "            \"dog\",\n",
    "            \"cat\",\n",
    "            \"horse\"\n",
    "        }\n",
    "        for obj in object_names\n",
    "    ):\n",
    "        scene_type = \"People / Animals\"\n",
    "\n",
    "    elif any(\n",
    "        obj in {\n",
    "            \"laptop\",\n",
    "            \"keyboard\",\n",
    "            \"mouse\",\n",
    "            \"tv\"\n",
    "        }\n",
    "        for obj in object_names\n",
    "    ):\n",
    "        scene_type = \"Technology\"\n",
    "\n",
    "    else:\n",
    "        scene_type = \"General\"\n",
    "\n",
    "    return {\n",
    "        \"environment\": environment,\n",
    "        \"scene_type\": scene_type\n",
    "    }"
   ]
  },
