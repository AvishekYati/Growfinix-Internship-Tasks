    "# ============================================================\n",
    "# LIGHTING ANALYSIS\n",
    "# ============================================================\n",
    "\n",
    "def analyze_lighting(image):\n",
    "\n",
    "    gray = cv2.cvtColor(\n",
    "        image,\n",
    "        cv2.COLOR_BGR2GRAY\n",
    "    )\n",
    "\n",
    "    brightness_mean = float(\n",
    "        np.mean(gray)\n",
    "    )\n",
    "\n",
    "    brightness_median = float(\n",
    "        np.median(gray)\n",
    "    )\n",
    "\n",
    "    # Pixel ratios\n",
    "    dark_pixels = np.sum(gray < 40)\n",
    "    bright_pixels = np.sum(gray > 220)\n",
    "\n",
    "    total_pixels = gray.size\n",
    "\n",
    "    shadow_ratio = (\n",
    "        dark_pixels / total_pixels * 100\n",
    "    )\n",
    "\n",
    "    highlight_ratio = (\n",
    "        bright_pixels / total_pixels * 100\n",
    "    )\n",
    "\n",
    "    if brightness_mean < 70:\n",
    "        lighting = \"Dark\"\n",
    "    elif brightness_mean < 180:\n",
    "        lighting = \"Normal\"\n",
    "    else:\n",
    "        lighting = \"Bright\"\n",
    "\n",
    "    # Exposure assessment\n",
    "    if shadow_ratio > 35:\n",
    "        exposure = \"Underexposed\"\n",
    "\n",
    "    elif highlight_ratio > 35:\n",
    "        exposure = \"Overexposed\"\n",
    "\n",
    "    else:\n",
    "        exposure = \"Normally Exposed\"\n",
    "\n",
    "    # Lighting quality heuristic\n",
    "    if (\n",
    "        70 <= brightness_mean <= 190\n",
    "        and shadow_ratio < 30\n",
    "        and highlight_ratio < 30\n",
    "    ):\n",
    "        quality = \"Good\"\n",
    "\n",
    "    elif (\n",
    "        shadow_ratio > 45\n",
    "        or highlight_ratio > 45\n",
    "    ):\n",
    "        quality = \"Poor\"\n",
    "\n",
    "    else:\n",
    "        quality = \"Moderate\"\n",
    "\n",
    "    return {\n",
    "        \"brightness_score\": round(\n",
    "            brightness_mean,\n",
    "            3\n",
    "        ),\n",
    "        \"brightness_median\": round(\n",
    "            brightness_median,\n",
    "            3\n",
    "        ),\n",
    "        \"shadow_ratio_percent\": round(\n",
    "            shadow_ratio,\n",
    "            3\n",
    "        ),\n",
    "        \"highlight_ratio_percent\": round(\n",
    "            highlight_ratio,\n",
    "            3\n",
    "        ),\n",
    "        \"lighting\": lighting,\n",
    "        \"exposure\": exposure,\n",
    "        \"lighting_quality\": quality\n",
    "    }"
   ]
  },
