    "        contrast[\"dynamic_range\"]\n",
    "    )\n",
    "\n",
    "    print(\"\\nIMAGE QUALITY\")\n",
    "    print(\"-\" * 70)\n",
    "\n",
    "    quality = metadata[\n",
    "        \"image_quality\"\n",
    "    ]\n",
    "\n",
    "    print(\n",
    "        \"Sharpness:\",\n",
    "        quality[\"sharpness_score\"]\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Blur:\",\n",
    "        quality[\"blur_status\"]\n",
