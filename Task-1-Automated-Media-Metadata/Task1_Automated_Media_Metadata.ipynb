   "source": [
    "# ============================================================\n",
    "# VIDEO TECHNICAL METADATA\n",
    "# ============================================================\n",
    "\n",
    "def get_video_metadata(video_path):\n",
    "\n",
    "    video_path = validate_media_path(\n",
    "        video_path\n",
    "    )\n",
    "\n",
    "    cap = cv2.VideoCapture(\n",
    "        str(video_path)\n",
    "    )\n",
    "\n",
    "    if not cap.isOpened():\n",
    "        raise ValueError(\n",
    "            f\"Could not open video: {video_path}\"\n",
    "        )\n",
    "\n",
    "    fps = cap.get(\n",
    "        cv2.CAP_PROP_FPS\n",
    "    )\n",
    "\n",
    "    frame_count = int(\n",
    "        cap.get(\n",
    "            cv2.CAP_PROP_FRAME_COUNT\n",
    "        )\n",
    "    )\n",
    "\n",
    "    width = int(\n",
    "        cap.get(\n",
    "            cv2.CAP_PROP_FRAME_WIDTH\n",
    "        )\n",
    "    )\n",
    "\n",
    "    height = int(\n",
    "        cap.get(\n",
    "            cv2.CAP_PROP_FRAME_HEIGHT\n",
    "        )\n",
    "    )\n",
    "\n",
    "    duration = (\n",
    "        frame_count / fps\n",
    "        if fps > 0\n",
    "        else 0\n",
    "    )\n",
    "\n",
    "    codec_value = int(\n",
    "        cap.get(\n",
    "            cv2.CAP_PROP_FOURCC\n",
    "        )\n",
    "    )\n",
    "\n",
    "    codec = \"\".join(\n",
    "        [\n",
    "            chr(\n",
    "                (codec_value >> 8 * i)\n",
    "                & 0xFF\n",
    "            )\n",
    "            for i in range(4)\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    cap.release()\n",
    "\n",
    "    return {\n",
    "        \"fps\": round(fps, 3),\n",
    "        \"frame_count\": frame_count,\n",
    "        \"width\": width,\n",
    "        \"height\": height,\n",
    "        \"resolution\":\n",
    "            f\"{width}x{height}\",\n",
    "        \"duration_seconds\":\n",
    "            round(duration, 3),\n",
    "        \"codec\": codec\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "90e54c56-0bac-46d8-afa1-bbae2aff1a07",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# VIDEO FRAME ANALYSIS + ANNOTATED VIDEO GENERATION\n",
    "# ============================================================\n",
    "\n",
    "def analyze_video(\n",
    "    video_path,\n",
    "    sample_interval_seconds=VIDEO_SAMPLE_INTERVAL_SECONDS,\n",
    "    save_metadata=True,\n",
    "    save_annotated_video=True\n",
    "):\n",
    "\n",
    "    video_path = validate_media_path(video_path)\n",
    "\n",
    "    if get_media_type(video_path) != \"video\":\n",
    "        raise ValueError(\n",
    "            \"Provided file is not a video.\"\n",
    "        )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 1. Video technical metadata\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    technical = get_video_metadata(\n",
    "        video_path\n",
    "    )\n",
    "\n",
    "    fps = technical[\"fps\"]\n",
    "\n",
    "    if fps <= 0:\n",
    "        raise ValueError(\n",
    "            \"Invalid video FPS.\"\n",
    "        )\n",
    "\n",
    "    frame_interval = max(\n",
    "        1,\n",
    "        int(\n",
    "            fps *\n",
    "            sample_interval_seconds\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 2. Open video\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    cap = cv2.VideoCapture(\n",
    "        str(video_path)\n",
    "    )\n",
    "\n",
    "    if not cap.isOpened():\n",
    "        raise ValueError(\n",
    "            \"Unable to open video.\"\n",
    "        )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 3. Create annotated video output\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    annotated_video_path = (\n",
    "        ANNOTATED_VIDEO_DIR /\n",
    "        f\"{video_path.stem}_annotated.mp4\"\n",
    "    )\n",
    "\n",
    "    writer = None\n",
    "\n",
    "    if save_annotated_video:\n",
    "\n",
    "        width = int(\n",
    "            cap.get(\n",
    "                cv2.CAP_PROP_FRAME_WIDTH\n",
    "            )\n",
    "        )\n",
    "\n",
    "        height = int(\n",
    "            cap.get(\n",
    "                cv2.CAP_PROP_FRAME_HEIGHT\n",
    "            )\n",
    "        )\n",
    "\n",
    "        video_fps = cap.get(\n",
    "            cv2.CAP_PROP_FPS\n",
    "        )\n",
    "\n",
    "        if video_fps <= 0:\n",
    "            video_fps = 30.0\n",
    "\n",
    "        fourcc = cv2.VideoWriter_fourcc(\n",
    "            *\"mp4v\"\n",
    "        )\n",
    "\n",
    "        writer = cv2.VideoWriter(\n",
    "            str(annotated_video_path),\n",
    "            fourcc,\n",
    "            video_fps,\n",
    "            (width, height)\n",
    "        )\n",
    "\n",
    "        if not writer.isOpened():\n",
    "\n",
    "            cap.release()\n",
    "\n",
    "            raise RuntimeError(\n",
    "                \"Unable to create annotated video. \"\n",
    "                \"The MP4 video writer could not be opened.\"\n",
    "            )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 4. Variables\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    frame_results = []\n",
    "\n",
    "    frame_number = 0\n",
    "\n",
    "    previous_gray = None\n",
    "\n",
    "    scene_changes = []\n",
    "\n",
    "    total_frames = technical[\n",
    "        \"frame_count\"\n",
    "    ]\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 5. Process video frames\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    with tqdm(\n",
    "        total=total_frames,\n",
    "        desc=\"Analyzing video\"\n",
    "    ) as progress:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            success, frame = cap.read()\n",
    "\n",
    "            if not success:\n",
    "                break\n",
    "\n",
    "            # ------------------------------------------------\n",
    "            # Scene-change calculation\n",
    "            # ------------------------------------------------\n",
    "\n",
    "            gray = cv2.cvtColor(\n",
    "                frame,\n",
    "                cv2.COLOR_BGR2GRAY\n",
    "            )\n",
    "\n",
    "            if (\n",
    "                previous_gray is not None\n",
    "                and frame_number % frame_interval == 0\n",
    "            ):\n",
    "\n",
    "                diff = cv2.absdiff(\n",
    "                    previous_gray,\n",
    "                    gray\n",
    "                )\n",
    "\n",
    "                mean_difference = float(\n",
    "                    np.mean(diff)\n",
    "                )\n",
    "\n",
    "                if mean_difference > 35:\n",
    "\n",
    "                    scene_changes.append({\n",
    "\n",
    "                        \"frame_number\":\n",
    "                            frame_number,\n",
    "\n",
    "                        \"timestamp_seconds\":\n",
    "                            round(\n",
    "                                frame_number / fps,\n",
    "                                3\n",
    "                            ),\n",
    "\n",
    "                        \"difference_score\":\n",
    "                            round(\n",
    "                                mean_difference,\n",
    "                                3\n",
    "                            )\n",
    "                    })\n",
    "\n",
    "            previous_gray = gray\n",
    "\n",
    "            # ------------------------------------------------\n",
    "            # Default frame for annotation\n",
    "            # ------------------------------------------------\n",
    "\n",
    "            annotated_frame = frame.copy()\n",
    "\n",
    "            # ------------------------------------------------\n",
    "            # Process sampled frames\n",
    "            # ------------------------------------------------\n",
    "\n",
    "            if (\n",
    "                frame_number %\n",
    "                frame_interval == 0\n",
    "            ):\n",
    "\n",
    "                detections, result = (\n",
    "                    detect_objects(\n",
    "                        frame\n",
    "                    )\n",
    "                )\n",
    "\n",
    "                # ------------------------------------------------\n",
    "                # Create YOLO annotated frame\n",
    "                # ------------------------------------------------\n",
    "\n",
    "                annotated_frame = result.plot()\n",
    "\n",
    "                # ------------------------------------------------\n",
    "                # Color analysis\n",
    "                # ------------------------------------------------\n",
    "\n",
    "                palette = (\n",
    "                    extract_color_palette(\n",
    "                        frame\n",
    "                    )\n",
    "                )\n",
    "\n",
    "                color_characteristics = (\n",
    "                    analyze_color_characteristics(\n",
    "                        frame\n",
    "                    )\n",
    "                )\n",
    "\n",
    "                # ------------------------------------------------\n",
    "                # Lighting\n",
    "                # ------------------------------------------------\n",
    "\n",
    "                lighting = (\n",
    "                    analyze_lighting(\n",
    "                        frame\n",
    "                    )\n",
    "                )\n",
    "\n",
    "                # ------------------------------------------------\n",
    "                # Contrast\n",
    "                # ------------------------------------------------\n",
    "\n",
    "                contrast = (\n",
    "                    analyze_contrast(\n",
    "                        frame\n",
    "                    )\n",
    "                )\n",
    "\n",
    "                # ------------------------------------------------\n",
    "                # Image quality\n",
    "                # ------------------------------------------------\n",
    "\n",
    "                quality = (\n",
    "                    analyze_image_quality(\n",
    "                        frame\n",
    "                    )\n",
    "                )\n",
    "\n",
    "                # ------------------------------------------------\n",
    "                # Scene classification\n",
    "                # ------------------------------------------------\n",
    "\n",
    "                scene = (\n",
    "                    classify_scene(\n",
    "                        detections\n",
    "                    )\n",
    "                )\n",
    "\n",
    "                # ------------------------------------------------\n",
    "                # Cinematic score\n",
    "                # ------------------------------------------------\n",
    "\n",
    "                cinematic = (\n",
    "                    calculate_cinematic_score(\n",
    "                        lighting,\n",
    "                        contrast,\n",
    "                        quality,\n",
    "                        color_characteristics\n",
    "                    )\n",
    "                )\n",
    "\n",
    "                # ------------------------------------------------\n",
    "                # Automatic tags\n",
    "                # ------------------------------------------------\n",
    "\n",
    "                tags = (\n",
    "                    generate_tags(\n",
    "                        detections,\n",
    "                        palette,\n",
    "                        lighting,\n",
    "                        contrast,\n",
    "                        quality,\n",
    "                        color_characteristics,\n",
    "                        scene\n",
    "                    )\n",
    "                )\n",
    "\n",
    "                # ------------------------------------------------\n",
    "                # Store frame metadata\n",
    "                # ------------------------------------------------\n",
    "\n",
    "                frame_results.append({\n",
    "\n",
    "                    \"frame_number\":\n",
    "                        frame_number,\n",
    "\n",
    "                    \"timestamp_seconds\":\n",
    "                        round(\n",
    "                            frame_number / fps,\n",
    "                            3\n",
    "                        ),\n",
    "\n",
    "                    \"objects\":\n",
    "                        detections,\n",
    "\n",
    "                    \"object_counts\":\n",
    "                        calculate_object_statistics(\n",
    "                            detections\n",
    "                        ),\n",
    "\n",
    "                    \"dominant_colors\":\n",
    "                        palette,\n",
    "\n",
    "                    \"color_characteristics\":\n",
    "                        color_characteristics,\n",
    "\n",
    "                    \"lighting\":\n",
    "                        lighting,\n",
    "\n",
    "                    \"contrast\":\n",
    "                        contrast,\n",
    "\n",
    "                    \"quality\":\n",
    "                        quality,\n",
    "\n",
    "                    \"scene\":\n",
    "                        scene,\n",
    "\n",
    "                    \"cinematic\":\n",
    "                        cinematic,\n",
    "\n",
    "                    \"tags\":\n",
    "                        tags\n",
    "                })\n",
    "\n",
    "                # ------------------------------------------------\n",
    "                # Add analysis information to video frame\n",
    "                # ------------------------------------------------\n",
    "\n",
    "                cv2.putText(\n",
    "                    annotated_frame,\n",
    "                    f\"Frame: {frame_number}\",\n",
    "                    (20, 35),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX,\n",
    "                    0.8,\n",
    "                    (0, 255, 0),\n",
    "                    2\n",
    "                )\n",
    "\n",
    "                cv2.putText(\n",
    "                    annotated_frame,\n",
    "                    f\"Objects: {len(detections)}\",\n",
    "                    (20, 70),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX,\n",
    "                    0.7,\n",
    "                    (0, 255, 0),\n",
    "                    2\n",
    "                )\n",
    "\n",
    "                cv2.putText(\n",
    "                    annotated_frame,\n",
    "                    f\"Brightness: \"\n",
    "                    f\"{lighting['brightness_score']:.1f}\",\n",
    "                    (20, 105),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX,\n",
    "                    0.7,\n",
    "                    (0, 255, 0),\n",
    "                    2\n",
    "                )\n",
    "\n",
    "                cv2.putText(\n",
    "                    annotated_frame,\n",
    "                    f\"Contrast: \"\n",
    "                    f\"{contrast['contrast_score']:.1f}\",\n",
    "                    (20, 140),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX,\n",
    "                    0.7,\n",
    "                    (0, 255, 0),\n",
    "                    2\n",
    "                )\n",
    "\n",
    "                cv2.putText(\n",
    "                    annotated_frame,\n",
    "                    f\"Cinematic: \"\n",
    "                    f\"{cinematic['cinematic_score']:.1f}\",\n",
    "                    (20, 175),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX,\n",
    "                    0.7,\n",
    "                    (0, 255, 0),\n",
    "                    2\n",
    "                )\n",
    "\n",
    "            # ------------------------------------------------\n",
    "            # WRITE FRAME TO ANNOTATED VIDEO\n",
    "            # ------------------------------------------------\n",
    "\n",
    "            if writer is not None:\n",
    "\n",
    "                writer.write(\n",
    "                    annotated_frame\n",
    "                )\n",
    "\n",
    "            frame_number += 1\n",
    "\n",
    "            progress.update(1)\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 6. Release video resources\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    cap.release()\n",
    "\n",
    "    if writer is not None:\n",
    "        writer.release()\n",
    "\n",
    "    cv2.destroyAllWindows()\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 7. Aggregate video-level statistics\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    all_objects = []\n",
    "\n",
    "    all_tags = []\n",
    "\n",
    "    brightness_values = []\n",
    "\n",
    "    contrast_values = []\n",
    "\n",
    "    sharpness_values = []\n",
    "\n",
    "    cinematic_values = []\n",
    "\n",
    "    for result in frame_results:\n",
    "\n",
    "        all_objects.extend([\n",
    "\n",
    "            obj[\"object\"]\n",
    "\n",
    "            for obj in result[\"objects\"]\n",
    "\n",
    "        ])\n",
    "\n",
    "        all_tags.extend(\n",
    "            result[\"tags\"]\n",
    "        )\n",
    "\n",
    "        brightness_values.append(\n",
    "\n",
    "            result[\n",
    "                \"lighting\"\n",
    "            ][\n",
    "                \"brightness_score\"\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "        contrast_values.append(\n",
    "\n",
    "            result[\n",
    "                \"contrast\"\n",
    "            ][\n",
    "                \"contrast_score\"\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "        sharpness_values.append(\n",
    "\n",
    "            result[\n",
    "                \"quality\"\n",
    "            ][\n",
    "                \"sharpness_score\"\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "        cinematic_values.append(\n",
    "\n",
    "            result[\n",
    "                \"cinematic\"\n",
    "            ][\n",
    "                \"cinematic_score\"\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 8. Object counts\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    object_counts = dict(\n",
    "        Counter(\n",
    "            all_objects\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 9. Tag counts\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    tag_counts = dict(\n",
    "        Counter(\n",
    "            all_tags\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 10. Final video metadata\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    video_metadata = {\n",
    "\n",
    "        \"project\": {\n",
    "\n",
    "            \"name\":\n",
    "                \"AI-Powered Automated Digital Media Metadata Extraction\",\n",
    "\n",
    "            \"version\":\n",
    "                \"1.0\"\n",
    "        },\n",
    "\n",
    "        \"file_information\":\n",
    "            get_file_metadata(\n",
    "                video_path\n",
    "            ),\n",
    "\n",
    "        \"video_information\":\n",
    "            technical,\n",
    "\n",
    "        \"analysis_configuration\": {\n",
    "\n",
    "            \"sample_interval_seconds\":\n",
    "                sample_interval_seconds,\n",
    "\n",
    "            \"frames_analyzed\":\n",
    "                len(\n",
    "                    frame_results\n",
    "                )\n",
    "        },\n",
    "\n",
    "        \"video_statistics\": {\n",
    "\n",
    "            \"objects\":\n",
    "                object_counts,\n",
    "\n",
    "            \"top_tags\":\n",
    "                dict(\n",
    "\n",
    "                    sorted(\n",
    "                        tag_counts.items(),\n",
    "                        key=lambda x: x[1],\n",
    "                        reverse=True\n",
    "                    )[:30]\n",
    "\n",
    "                ),\n",
    "\n",
    "            \"average_brightness\":\n",
    "                round(\n",
    "\n",
    "                    float(\n",
    "                        np.mean(\n",
    "                            brightness_values\n",
    "                        )\n",
    "                    ),\n",
    "\n",
    "                    3\n",
    "\n",
    "                )\n",
    "                if brightness_values\n",
    "                else 0,\n",
    "\n",
    "            \"average_contrast\":\n",
    "                round(\n",
    "\n",
    "                    float(\n",
    "                        np.mean(\n",
    "                            contrast_values\n",
    "                        )\n",
    "                    ),\n",
    "\n",
    "                    3\n",
    "\n",
    "                )\n",
    "                if contrast_values\n",
    "                else 0,\n",
    "\n",
    "            \"average_sharpness\":\n",
    "                round(\n",
    "\n",
    "                    float(\n",
    "                        np.mean(\n",
    "                            sharpness_values\n",
    "                        )\n",
    "                    ),\n",
    "\n",
    "                    3\n",
    "\n",
    "                )\n",
    "                if sharpness_values\n",
    "                else 0,\n",
    "\n",
    "            \"average_cinematic_score\":\n",
    "                round(\n",
    "\n",
    "                    float(\n",
    "                        np.mean(\n",
    "                            cinematic_values\n",
    "                        )\n",
    "                    ),\n",
    "\n",
    "                    3\n",
    "\n",
    "                )\n",
    "                if cinematic_values\n",
    "                else 0\n",
    "        },\n",
    "\n",
    "        \"scene_changes\":\n",
    "            scene_changes,\n",
    "\n",
    "        \"annotated_video\":\n",
    "            str(\n",
    "                annotated_video_path\n",
    "            )\n",
    "            if save_annotated_video\n",
    "            else None,\n",
    "\n",
    "        \"frames\":\n",
    "            frame_results\n",
    "    }\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 11. Save JSON metadata\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if save_metadata:\n",
    "\n",
    "        output_path = (\n",
    "\n",
    "            METADATA_DIR /\n",
    "\n",
    "            f\"{video_path.stem}_metadata.json\"\n",
    "\n",
    "        )\n",
    "\n",
    "        with open(\n",
    "\n",
    "            output_path,\n",
    "\n",
    "            \"w\",\n",
    "\n",
    "            encoding=\"utf-8\"\n",
    "\n",
    "        ) as f:\n",
    "\n",
    "            json.dump(\n",
    "\n",
    "                video_metadata,\n",
    "\n",
    "                f,\n",
    "\n",
    "                indent=4\n",
    "\n",
    "            )\n",
    "\n",
    "        print(\n",
    "            f\"Metadata saved to: {output_path}\"\n",
    "        )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 12. Confirm annotated video\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if save_annotated_video:\n",
    "\n",
    "        if annotated_video_path.exists():\n",
    "\n",
    "            size_mb = (\n",
    "\n",
    "                annotated_video_path.stat().st_size\n",
    "                / (1024 ** 2)\n",
    "\n",
    "            )\n",
    "\n",
    "            print(\n",
    "                \"\\nAnnotated video saved to:\"\n",
    "            )\n",
    "\n",
    "            print(\n",
    "                annotated_video_path\n",
    "            )\n",
    "\n",
    "            print(\n",
    "                f\"Annotated video size: \"\n",
    "                f\"{size_mb:.2f} MB\"\n",
    "            )\n",
    "\n",
    "        else:\n",
    "\n",
    "            print(\n",
    "                \"\\nWARNING: Annotated video \"\n",
    "                \"was not created.\"\n",
    "            )\n",
    "\n",
    "    return video_metadata"
   ]
  },
