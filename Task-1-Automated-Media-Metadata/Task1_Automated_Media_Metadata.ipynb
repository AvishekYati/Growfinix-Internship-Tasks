    "\n",
    "    print(\"\\nSCENE\")\n",
    "    print(\"-\" * 70)\n",
    "\n",
    "    scene = metadata[\n",
    "        \"scene_analysis\"\n",
    "    ]\n",
    "\n",
    "    print(\n",
    "        \"Environment:\",\n",
    "        scene[\"environment\"]\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Scene Type:\",\n",
    "        scene[\"scene_type\"]\n",
