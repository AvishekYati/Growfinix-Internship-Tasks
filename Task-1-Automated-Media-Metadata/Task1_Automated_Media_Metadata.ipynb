    "# ============================================================\n",
    "# AUTOMATIC TAG GENERATION\n",
    "# ============================================================\n",
    "\n",
    "def generate_tags(\n",
    "    detections,\n",
    "    palette,\n",
    "    lighting,\n",
    "    contrast,\n",
    "    quality,\n",
    "    color_analysis,\n",
    "    scene\n",
    "):\n",
    "\n",
    "    tags = set()\n",
    "\n",
    "    # Object tags\n",
    "    for detection in detections:\n",
    "        tags.add(\n",
    "            detection[\"object\"]\n",
    "        )\n",
    "\n",
    "    # Dominant colors\n",
    "    for color in palette[:5]:\n",
    "        tags.add(\n",
    "            color[\"name\"]\n",
    "        )\n",
    "\n",
    "    # Lighting\n",
    "    tags.add(\n",
    "        lighting[\"lighting\"].lower()\n",
    "    )\n",
    "\n",
    "    # Exposure\n",
    "    tags.add(\n",
    "        lighting[\"exposure\"].lower()\n",
    "    )\n",
    "\n",
    "    # Contrast\n",
    "    tags.add(\n",
    "        f\"{contrast['contrast_level'].lower()}-contrast\"\n",
    "    )\n",
    "\n",
    "    # Quality\n",
    "    if quality[\"blur_status\"] == \"Sharp\":\n",
    "        tags.add(\"sharp\")\n",
    "\n",
    "    elif quality[\"blur_status\"] == \"Blurry\":\n",
    "        tags.add(\"blurry\")\n",
    "\n",
    "    if quality[\"noise_level\"] == \"Low\":\n",
    "        tags.add(\"low-noise\")\n",
    "\n",
    "    elif quality[\"noise_level\"] == \"High\":\n",
    "        tags.add(\"high-noise\")\n",
    "\n",
    "    # Color temperature\n",
    "    tags.add(\n",
    "        color_analysis[\n",
    "            \"color_temperature\"\n",
    "        ].lower() + \"-tone\"\n",
    "    )\n",
    "\n",
    "    # Scene\n",
    "    tags.add(\n",
    "        scene[\"environment\"].lower()\n",
    "    )\n",
    "\n",
    "    tags.add(\n",
    "        scene[\"scene_type\"].lower()\n",
    "        .replace(\" \", \"-\")\n",
    "        .replace(\"/\", \"-\")\n",
    "    )\n",
    "\n",
    "    return sorted(tags)"
   ]
  },
