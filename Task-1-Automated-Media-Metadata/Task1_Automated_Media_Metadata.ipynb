    "\n",
    "    print(\n",
    "        \", \".join(\n",
    "            metadata[\n",
    "                \"automatic_tags\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "    print(\"=\" * 70)"
   ]
