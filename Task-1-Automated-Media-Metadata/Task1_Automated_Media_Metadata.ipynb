    "# ============================================================\n",
    "# COLOR PALETTE VISUALIZATION\n",
    "# ============================================================\n",
    "\n",
    "def create_palette_image(\n",
    "    palette,\n",
    "    output_path\n",
    "):\n",
    "\n",
    "    if not palette:\n",
    "        return\n",
    "\n",
    "    fig, ax = plt.subplots(\n",
    "        figsize=(14, 3)\n",
    "    )\n",
    "\n",
    "    start = 0\n",
    "\n",
    "    for color in palette:\n",
    "\n",
    "        percentage = color[\n",
    "            \"percentage\"\n",
    "        ]\n",
    "\n",
    "        rgb = np.array(\n",
    "            color[\"rgb\"]\n",
    "        ) / 255.0\n",
    "\n",
    "        ax.barh(\n",
    "            0,\n",
    "            percentage,\n",
    "            left=start,\n",
    "            color=rgb\n",
    "        )\n",
    "\n",
    "        start += percentage\n",
    "\n",
    "    ax.set_xlim(0, 100)\n",
    "    ax.set_yticks([])\n",
    "\n",
    "    ax.set_xlabel(\n",
    "        \"Percentage of Image\"\n",
    "    )\n",
    "\n",
    "    ax.set_title(\n",
    "        \"Dominant Color Palette\"\n",
    "    )\n",
    "\n",
    "    plt.tight_layout()\n",
    "\n",
    "    plt.savefig(\n",
    "        output_path,\n",
    "        dpi=200,\n",
    "        bbox_inches=\"tight\"\n",
    "    )\n",
    "\n",
    "    plt.close()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "2b97ca11-3115-4350-b493-276fc3bbd18b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# COMPLETE IMAGE ANALYSIS PIPELINE\n",
    "# ============================================================\n",
    "\n",
    "def analyze_image(\n",
    "    image_path,\n",
    "    save_outputs=True\n",
    "):\n",
    "\n",
    "    start_time = time.time()\n",
    "\n",
    "    image_path = validate_media_path(\n",
    "        image_path\n",
    "    )\n",
    "\n",
    "    if get_media_type(image_path) != \"image\":\n",
    "        raise ValueError(\n",
    "            \"Provided file is not an image.\"\n",
    "        )\n",
    "\n",
    "    image = cv2.imread(\n",
    "        str(image_path)\n",
    "    )\n",
    "\n",
    "    if image is None:\n",
    "        raise ValueError(\n",
    "            f\"Could not load image: {image_path}\"\n",
    "        )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 1. File metadata\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    file_metadata = get_file_metadata(\n",
    "        image_path\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 2. Technical metadata\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    technical = (\n",
    "        get_image_technical_metadata(\n",
    "            image_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 3. Object detection\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    detections, result = detect_objects(\n",
    "        image\n",
    "    )\n",
    "\n",
    "    object_statistics = (\n",
    "        calculate_object_statistics(\n",
    "            detections\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 4. Color analysis\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    palette = extract_color_palette(\n",
    "        image\n",
    "    )\n",
    "\n",
    "    color_characteristics = (\n",
    "        analyze_color_characteristics(\n",
    "            image\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 5. Lighting\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    lighting = analyze_lighting(\n",
    "        image\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 6. Contrast\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    contrast = analyze_contrast(\n",
    "        image\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 7. Quality\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    quality = analyze_image_quality(\n",
    "        image\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 8. Scene\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    scene = classify_scene(\n",
    "        detections\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 9. Cinematic score\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    cinematic = calculate_cinematic_score(\n",
    "        lighting,\n",
    "        contrast,\n",
    "        quality,\n",
    "        color_characteristics\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # 10. Automatic tags\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    tags = generate_tags(\n",
    "        detections,\n",
    "        palette,\n",
    "        lighting,\n",
    "        contrast,\n",
    "        quality,\n",
    "        color_characteristics,\n",
    "        scene\n",
    "    )\n",
    "\n",
    "    processing_time = (\n",
    "        time.time() - start_time\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # FINAL METADATA\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    metadata = {\n",
    "        \"project\": {\n",
    "            \"name\":\n",
    "                \"AI-Powered Automated Digital Media Metadata Extraction\",\n",
    "            \"version\": \"1.0\"\n",
    "        },\n",
    "\n",
    "        \"file_information\":\n",
    "            file_metadata,\n",
    "\n",
    "        \"technical_metadata\":\n",
    "            technical,\n",
    "\n",
    "        \"object_detection\": {\n",
    "            \"detections\":\n",
    "                detections,\n",
    "            \"statistics\":\n",
    "                object_statistics\n",
    "        },\n",
    "\n",
    "        \"color_analysis\": {\n",
    "            \"dominant_colors\":\n",
    "                palette,\n",
    "            \"characteristics\":\n",
    "                color_characteristics\n",
    "        },\n",
    "\n",
    "        \"lighting_analysis\":\n",
    "            lighting,\n",
    "\n",
    "        \"contrast_analysis\":\n",
    "            contrast,\n",
    "\n",
    "        \"image_quality\":\n",
    "            quality,\n",
    "\n",
    "        \"scene_analysis\":\n",
    "            scene,\n",
    "\n",
    "        \"cinematic_analysis\":\n",
    "            cinematic,\n",
    "\n",
    "        \"automatic_tags\":\n",
    "            tags,\n",
    "\n",
    "        \"processing\": {\n",
    "            \"processing_time_seconds\":\n",
    "                round(\n",
    "                    processing_time,\n",
    "                    3\n",
    "                )\n",
    "        }\n",
    "    }\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # SAVE OUTPUTS\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if save_outputs:\n",
    "\n",
    "        # JSON\n",
    "        json_path = (\n",
    "            METADATA_DIR /\n",
    "            f\"{image_path.stem}_metadata.json\"\n",
    "        )\n",
    "\n",
    "        with open(\n",
    "            json_path,\n",
    "            \"w\",\n",
    "            encoding=\"utf-8\"\n",
    "        ) as f:\n",
    "\n",
    "            json.dump(\n",
    "                metadata,\n",
    "                f,\n",
    "                indent=4\n",
    "            )\n",
    "\n",
    "        # Annotated image\n",
    "        annotated_path = (\n",
    "            ANNOTATED_IMAGE_DIR /\n",
    "            f\"{image_path.stem}_annotated.jpg\"\n",
    "        )\n",
    "\n",
    "        annotated_image = result.plot()\n",
    "\n",
    "        cv2.imwrite(\n",
    "            str(annotated_path),\n",
    "            annotated_image\n",
    "        )\n",
    "\n",
    "        # Palette\n",
    "        palette_path = (\n",
    "            PALETTE_DIR /\n",
    "            f\"{image_path.stem}_palette.png\"\n",
    "        )\n",
    "\n",
    "        create_palette_image(\n",
    "            palette,\n",
    "            palette_path\n",
    "        )\n",
    "\n",
    "    return metadata"
   ]
  },
