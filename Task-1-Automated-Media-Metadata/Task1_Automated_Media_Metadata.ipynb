    "# ============================================================\n",
    "# CINEMATIC QUALITY HEURISTIC\n",
    "# ============================================================\n",
    "\n",
    "def calculate_cinematic_score(\n",
    "    lighting,\n",
    "    contrast,\n",
    "    quality,\n",
    "    color_analysis\n",
    "):\n",
    "\n",
    "    score = 0\n",
    "\n",
    "    # Lighting component\n",
    "    if lighting[\"lighting_quality\"] == \"Good\":\n",
    "        lighting_score = 90\n",
    "    elif lighting[\"lighting_quality\"] == \"Moderate\":\n",
    "        lighting_score = 65\n",
    "    else:\n",
    "        lighting_score = 35\n",
    "\n",
    "    # Contrast component\n",
    "    contrast_score = min(\n",
    "        100,\n",
    "        contrast[\"contrast_score\"] * 1.25\n",
    "    )\n",
    "\n",
    "    # Sharpness component\n",
    "    sharpness_score = min(\n",
    "        100,\n",
    "        quality[\"sharpness_score\"] / 5\n",
    "    )\n",
    "\n",
    "    # Saturation\n",
    "    saturation = color_analysis[\n",
    "        \"average_saturation\"\n",
    "    ]\n",
    "\n",
    "    if 60 <= saturation <= 180:\n",
    "        saturation_score = 90\n",
    "    elif saturation < 30:\n",
    "        saturation_score = 50\n",
    "    else:\n",
    "        saturation_score = 75\n",
    "\n",
    "    score = (\n",
    "        lighting_score * 0.30\n",
    "        + contrast_score * 0.25\n",
    "        + sharpness_score * 0.25\n",
    "        + saturation_score * 0.20\n",
    "    )\n",
    "\n",
    "    score = min(\n",
    "        100,\n",
    "        max(0, score)\n",
    "    )\n",
    "\n",
    "    if score >= 80:\n",
    "        rating = \"Excellent\"\n",
    "\n",
    "    elif score >= 65:\n",
    "        rating = \"Good\"\n",
    "\n",
    "    elif score >= 50:\n",
    "        rating = \"Moderate\"\n",
    "\n",
    "    else:\n",
    "        rating = \"Low\"\n",
    "\n",
    "    return {\n",
    "        \"cinematic_score\": round(\n",
    "            score,\n",
    "            2\n",
    "        ),\n",
    "        \"rating\": rating\n",
    "    }"
   ]
  },
  {
