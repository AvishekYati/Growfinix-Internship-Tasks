   "source": [
    "# ============================================================\n",
    "# COLOR UTILITIES\n",
    "# ============================================================\n",
    "\n",
    "def rgb_to_hex(rgb):\n",
    "    r, g, b = [int(x) for x in rgb]\n",
    "\n",
    "    return \"#{:02X}{:02X}{:02X}\".format(\n",
    "        r, g, b\n",
    "    )\n",
    "\n",
    "\n",
    "def rgb_to_hsv(rgb):\n",
    "    rgb_array = np.uint8(\n",
    "        [[list(rgb)]]\n",
    "    )\n",
    "\n",
    "    hsv = cv2.cvtColor(\n",
    "        rgb_array,\n",
    "        cv2.COLOR_RGB2HSV\n",
    "    )[0][0]\n",
    "\n",
    "    return {\n",
    "        \"h\": int(hsv[0]),\n",
    "        \"s\": int(hsv[1]),\n",
    "        \"v\": int(hsv[2])\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "0d1a7640-994e-4744-b559-2cc5d42e00d9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# APPROXIMATE HUMAN-READABLE COLOR NAME\n",
    "# ============================================================\n",
    "\n",
    "def rgb_to_color_name(rgb):\n",
    "\n",
    "    r, g, b = [int(x) for x in rgb]\n",
    "\n",
    "    hsv = rgb_to_hsv(rgb)\n",
    "\n",
    "    h = hsv[\"h\"]\n",
    "    s = hsv[\"s\"]\n",
    "    v = hsv[\"v\"]\n",
    "\n",
    "    # Black / White / Gray\n",
    "    if v < 35:\n",
    "        return \"black\"\n",
    "\n",
    "    if s < 25 and v > 220:\n",
    "        return \"white\"\n",
    "\n",
    "    if s < 30:\n",
    "        return \"gray\"\n",
    "\n",
    "    # Brown\n",
    "    if 5 <= h <= 25 and 50 <= s <= 255 and v < 180:\n",
    "        return \"brown\"\n",
    "\n",
    "    # OpenCV Hue is 0-179\n",
    "    if h < 8 or h >= 170:\n",
    "        return \"red\"\n",
    "\n",
    "    if 8 <= h < 20:\n",
    "        return \"orange\"\n",
    "\n",
    "    if 20 <= h < 35:\n",
    "        return \"yellow\"\n",
    "\n",
    "    if 35 <= h < 85:\n",
    "        return \"green\"\n",
    "\n",
    "    if 85 <= h < 105:\n",
    "        return \"cyan\"\n",
    "\n",
    "    if 105 <= h < 135:\n",
    "        return \"blue\"\n",
    "\n",
    "    if 135 <= h < 160:\n",
    "        return \"purple\"\n",
    "\n",
    "    if 160 <= h < 170:\n",
    "        return \"pink\"\n",
    "\n",
    "    return \"mixed\""
   ]
  },
  {
   "cell_type": "code",
