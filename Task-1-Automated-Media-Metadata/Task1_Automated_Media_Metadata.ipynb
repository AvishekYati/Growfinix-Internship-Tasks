    "# ============================================================\n",
    "# BATCH IMAGE PROCESSING\n",
    "# ============================================================\n",
    "\n",
    "def process_all_images():\n",
    "\n",
    "    records = []\n",
    "\n",
    "    image_files = [\n",
    "        p\n",
    "        for p in IMAGE_INPUT_DIR.iterdir()\n",
    "        if p.suffix.lower()\n",
    "        in IMAGE_EXTENSIONS\n",
    "    ]\n",
    "\n",
    "    print(\n",
    "        f\"Found {len(image_files)} image(s).\"\n",
    "    )\n",
    "\n",
    "    for image_path in tqdm(\n",
    "        image_files,\n",
    "        desc=\"Processing images\"\n",
    "    ):\n",
    "\n",
    "        try:\n",
    "\n",
    "            metadata = analyze_image(\n",
    "                image_path,\n",
    "                save_outputs=True\n",
    "            )\n",
    "\n",
    "            stats = metadata[\n",
    "                \"object_detection\"\n",
    "            ][\"statistics\"]\n",
    "\n",
    "            lighting = metadata[\n",
    "                \"lighting_analysis\"\n",
    "            ]\n",
    "\n",
    "            contrast = metadata[\n",
    "                \"contrast_analysis\"\n",
    "            ]\n",
    "\n",
    "            quality = metadata[\n",
    "                \"image_quality\"\n",
    "            ]\n",
    "\n",
    "            records.append({\n",
    "\n",
    "                \"filename\":\n",
    "                    image_path.name,\n",
    "\n",
    "                \"media_type\":\n",
    "                    \"image\",\n",
    "\n",
    "                \"resolution\":\n",
    "                    metadata[\n",
    "                        \"technical_metadata\"\n",
    "                    ][\"resolution\"],\n",
    "\n",
    "                \"objects\":\n",
    "                    \", \".join(\n",
    "                        stats[\n",
    "                            \"object_counts\"\n",
    "                        ].keys()\n",
    "                    ),\n",
    "\n",
    "                \"object_count\":\n",
    "                    stats[\n",
    "                        \"total_objects\"\n",
    "                    ],\n",
    "\n",
    "                \"brightness\":\n",
    "                    lighting[\n",
    "                        \"brightness_score\"\n",
    "                    ],\n",
    "\n",
    "                \"lighting\":\n",
    "                    lighting[\n",
    "                        \"lighting\"\n",
    "                    ],\n",
    "\n",
    "                \"contrast\":\n",
    "                    contrast[\n",
    "                        \"contrast_level\"\n",
    "                    ],\n",
    "\n",
    "                \"sharpness\":\n",
    "                    quality[\n",
    "                        \"sharpness_score\"\n",
    "                    ],\n",
    "\n",
    "                \"quality\":\n",
    "                    quality[\n",
    "                        \"blur_status\"\n",
    "                    ],\n",
    "\n",
    "                \"tags\":\n",
    "                    \", \".join(\n",
    "                        metadata[\n",
    "                            \"automatic_tags\"\n",
    "                        ]\n",
    "                    )\n",
    "            })\n",
    "\n",
    "        except Exception as e:\n",
    "\n",
    "            print(\n",
    "                f\"Error processing \"\n",
    "                f\"{image_path.name}: {e}\"\n",
    "            )\n",
    "\n",
    "    df = pd.DataFrame(records)\n",
    "\n",
    "    csv_path = (\n",
    "        REPORT_DIR /\n",
    "        \"media_inventory.csv\"\n",
    "    )\n",
    "\n",
    "    df.to_csv(\n",
    "        csv_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"Inventory saved to: {csv_path}\"\n",
    "    )\n",
    "\n",
    "    return df"
   ]
