    "# ============================================================\n",
    "# CONTRAST ANALYSIS\n",
    "# ============================================================\n",
    "\n",
    "def analyze_contrast(image):\n",
    "\n",
    "    gray = cv2.cvtColor(\n",
    "        image,\n",
    "        cv2.COLOR_BGR2GRAY\n",
    "    )\n",
    "\n",
    "    standard_deviation = float(\n",
    "        np.std(gray)\n",
    "    )\n",
    "\n",
    "    min_value = int(\n",
    "        np.min(gray)\n",
    "    )\n",
    "\n",
    "    max_value = int(\n",
    "        np.max(gray)\n",
    "    )\n",
    "\n",
    "    dynamic_range = max_value - min_value\n",
    "\n",
    "    if standard_deviation < 35:\n",
    "        contrast_level = \"Low\"\n",
    "\n",
    "    elif standard_deviation < 70:\n",
    "        contrast_level = \"Medium\"\n",
    "\n",
    "    else:\n",
    "        contrast_level = \"High\"\n",
    "\n",
    "    return {\n",
    "        \"contrast_score\": round(\n",
    "            standard_deviation,\n",
    "            3\n",
    "        ),\n",
    "        \"minimum_intensity\": min_value,\n",
    "        \"maximum_intensity\": max_value,\n",
    "        \"dynamic_range\": dynamic_range,\n",
    "        \"contrast_level\": contrast_level\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
