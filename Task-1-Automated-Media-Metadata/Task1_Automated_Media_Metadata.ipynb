   "source": [
    "# ============================================================\n",
    "# OBJECT STATISTICS\n",
    "# ============================================================\n",
    "\n",
    "def calculate_object_statistics(detections):\n",
    "\n",
    "    if not detections:\n",
    "        return {\n",
    "            \"total_objects\": 0,\n",
    "            \"unique_object_classes\": 0,\n",
    "            \"object_counts\": {},\n",
    "            \"average_confidence\": 0,\n",
    "            \"highest_confidence\": 0,\n",
    "            \"lowest_confidence\": 0\n",
    "        }\n",
    "\n",
    "    object_names = [\n",
    "        d[\"object\"]\n",
    "        for d in detections\n",
    "    ]\n",
    "\n",
    "    confidences = [\n",
    "        d[\"confidence\"]\n",
    "        for d in detections\n",
    "    ]\n",
    "\n",
    "    counts = dict(\n",
    "        Counter(object_names)\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"total_objects\": len(detections),\n",
    "        \"unique_object_classes\": len(counts),\n",
    "        \"object_counts\": counts,\n",
    "        \"average_confidence\": round(\n",
    "            float(np.mean(confidences)),\n",
    "            4\n",
    "        ),\n",
    "        \"highest_confidence\": round(\n",
    "            float(np.max(confidences)),\n",
    "            4\n",
    "        ),\n",
    "        \"lowest_confidence\": round(\n",
    "            float(np.min(confidences)),\n",
    "            4\n",
    "        )\n",
    "    }"
   ]
  },
  {
