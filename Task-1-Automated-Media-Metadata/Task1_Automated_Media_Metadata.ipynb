    "    print(\"AI MEDIA METADATA REPORT\")\n",
    "    print(\"=\" * 70)\n",
    "\n",
    "    file_info = metadata[\n",
    "        \"file_information\"\n",
    "    ]\n",
    "\n",
    "    technical = metadata[\n",
    "        \"technical_metadata\"\n",
