   "source": [
    "# ============================================================\n",
    "# IMAGE QUALITY ANALYSIS\n",
    "# ============================================================\n",
    "\n",
    "def analyze_image_quality(image):\n",
    "\n",
    "    gray = cv2.cvtColor(\n",
    "        image,\n",
    "        cv2.COLOR_BGR2GRAY\n",
    "    )\n",
    "\n",
    "    # Sharpness / blur\n",
    "    laplacian = cv2.Laplacian(\n",
    "        gray,\n",
    "        cv2.CV_64F\n",
    "    )\n",
    "\n",
    "    sharpness = float(\n",
    "        laplacian.var()\n",
    "    )\n",
    "\n",
    "    if sharpness < 50:\n",
    "        blur_status = \"Blurry\"\n",
    "\n",
    "    elif sharpness < 150:\n",
    "        blur_status = \"Slightly Blurry\"\n",
    "\n",
    "    else:\n",
    "        blur_status = \"Sharp\"\n",
    "\n",
    "    # Approximate noise estimate\n",
    "    median = cv2.medianBlur(\n",
    "        gray,\n",
    "        3\n",
    "    )\n",
    "\n",
    "    noise = gray.astype(\n",
    "        np.float32\n",
    "    ) - median.astype(\n",
    "        np.float32\n",
    "    )\n",
    "\n",
    "    noise_score = float(\n",
    "        np.std(noise)\n",
    "    )\n",
    "\n",
    "    if noise_score < 5:\n",
    "        noise_level = \"Low\"\n",
    "\n",
    "    elif noise_score < 15:\n",
    "        noise_level = \"Medium\"\n",
    "\n",
    "    else:\n",
    "        noise_level = \"High\"\n",
    "\n",
    "    return {\n",
    "        \"sharpness_score\": round(\n",
    "            sharpness,\n",
    "            3\n",
    "        ),\n",
    "        \"blur_status\": blur_status,\n",
    "        \"noise_score\": round(\n",
    "            noise_score,\n",
    "            3\n",
    "        ),\n",
    "        \"noise_level\": noise_level\n",
    "    }"
   ]
  },
