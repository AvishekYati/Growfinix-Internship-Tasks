   "source": [
    "# ============================================================\n",
    "# ADVANCED COLOR STATISTICS\n",
    "# ============================================================\n",
    "\n",
    "def analyze_color_characteristics(image):\n",
    "\n",
    "    hsv = cv2.cvtColor(\n",
    "        image,\n",
    "        cv2.COLOR_BGR2HSV\n",
    "    )\n",
    "\n",
    "    saturation = hsv[:, :, 1]\n",
    "    value = hsv[:, :, 2]\n",
    "\n",
    "    mean_saturation = float(\n",
    "        np.mean(saturation)\n",
    "    )\n",
    "\n",
    "    mean_value = float(\n",
    "        np.mean(value)\n",
    "    )\n",
    "\n",
    "    if mean_saturation < 60:\n",
    "        saturation_level = \"Low\"\n",
    "    elif mean_saturation < 150:\n",
    "        saturation_level = \"Medium\"\n",
    "    else:\n",
    "        saturation_level = \"High\"\n",
    "\n",
    "    # Approximate color temperature\n",
    "    b, g, r = cv2.split(image)\n",
    "\n",
    "    mean_r = np.mean(r)\n",
    "    mean_b = np.mean(b)\n",
    "\n",
    "    if mean_r > mean_b * 1.10:\n",
    "        temperature = \"Warm\"\n",
    "    elif mean_b > mean_r * 1.10:\n",
    "        temperature = \"Cool\"\n",
    "    else:\n",
    "        temperature = \"Neutral\"\n",
    "\n",
    "    return {\n",
    "        \"average_saturation\": round(\n",
    "            mean_saturation,\n",
    "            3\n",
    "        ),\n",
    "        \"average_value\": round(\n",
    "            mean_value,\n",
    "            3\n",
    "        ),\n",
    "        \"saturation_level\": saturation_level,\n",
    "        \"color_temperature\": temperature\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
