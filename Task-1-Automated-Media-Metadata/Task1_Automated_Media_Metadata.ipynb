    "    )\n",
    "\n",
    "    df.to_csv(\n",
    "        csv_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"Video inventory saved to: {csv_path}\"\n",
    "    )\n",
    "\n",
    "    return df"
   ]
