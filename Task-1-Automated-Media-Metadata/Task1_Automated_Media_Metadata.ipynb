   "source": [
    "# ============================================================\n",
    "# DOMINANT COLOR PALETTE\n",
    "# ============================================================\n",
    "\n",
    "def extract_color_palette(\n",
    "    image,\n",
    "    number_of_colors=NUMBER_OF_DOMINANT_COLORS\n",
    "):\n",
    "\n",
    "    if image is None:\n",
    "        raise ValueError(\"Image is empty.\")\n",
    "\n",
    "    rgb_image = cv2.cvtColor(\n",
    "        image,\n",
    "        cv2.COLOR_BGR2RGB\n",
    "    )\n",
    "\n",
    "    pixels = rgb_image.reshape(-1, 3)\n",
    "\n",
    "    # Sample pixels for performance\n",
    "    max_pixels = 20000\n",
    "\n",
    "    if len(pixels) > max_pixels:\n",
    "        rng = np.random.default_rng(42)\n",
    "\n",
    "        indices = rng.choice(\n",
    "            len(pixels),\n",
    "            max_pixels,\n",
    "            replace=False\n",
    "        )\n",
    "\n",
    "        pixels = pixels[indices]\n",
    "\n",
    "    unique_pixels = np.unique(\n",
    "        pixels,\n",
    "        axis=0\n",
    "    )\n",
    "\n",
    "    n_clusters = min(\n",
    "        number_of_colors,\n",
    "        len(unique_pixels)\n",
    "    )\n",
    "\n",
    "    if n_clusters < 1:\n",
    "        return []\n",
    "\n",
    "    kmeans = KMeans(\n",
    "        n_clusters=n_clusters,\n",
    "        random_state=42,\n",
    "        n_init=10\n",
    "    )\n",
    "\n",
    "    labels = kmeans.fit_predict(pixels)\n",
    "\n",
    "    centers = (\n",
    "        kmeans.cluster_centers_\n",
    "        .astype(int)\n",
    "    )\n",
    "\n",
    "    counts = np.bincount(labels)\n",
    "\n",
    "    percentages = (\n",
    "        counts / counts.sum() * 100\n",
    "    )\n",
    "\n",
    "    sorted_indices = np.argsort(\n",
    "        percentages\n",
    "    )[::-1]\n",
    "\n",
    "    palette = []\n",
    "\n",
    "    for idx in sorted_indices:\n",
    "\n",
    "        rgb = centers[idx]\n",
    "\n",
    "        rgb = np.clip(\n",
    "            rgb,\n",
    "            0,\n",
    "            255\n",
    "        )\n",
    "\n",
    "        rgb_tuple = tuple(\n",
    "            int(x)\n",
    "            for x in rgb\n",
    "        )\n",
    "\n",
    "        hsv = rgb_to_hsv(\n",
    "            rgb_tuple\n",
    "        )\n",
    "\n",
    "        palette.append({\n",
    "            \"name\": rgb_to_color_name(\n",
    "                rgb_tuple\n",
    "            ),\n",
    "            \"rgb\": list(rgb_tuple),\n",
    "            \"hex\": rgb_to_hex(\n",
    "                rgb_tuple\n",
    "            ),\n",
    "            \"hsv\": hsv,\n",
    "            \"percentage\": round(\n",
    "                float(percentages[idx]),\n",
    "                3\n",
    "            )\n",
    "        })\n",
    "\n",
    "    return palette"
   ]
  },
  {
   "cell_type": "code",
