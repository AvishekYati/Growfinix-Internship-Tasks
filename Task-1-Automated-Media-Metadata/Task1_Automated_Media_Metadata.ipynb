    "\n",
    "    print(\"\\nCINEMATIC ANALYSIS\")\n",
    "    print(\"-\" * 70)\n",
    "\n",
    "    cinematic = metadata[\n",
    "        \"cinematic_analysis\"\n",
    "    ]\n",
    "\n",
    "    print(\n",
    "        \"Score:\",\n",
    "        cinematic[\"cinematic_score\"]\n",
