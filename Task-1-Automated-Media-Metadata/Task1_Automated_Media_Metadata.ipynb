    "# ============================================================\n",
    "# BATCH VIDEO PROCESSING\n",
    "# ============================================================\n",
    "\n",
    "def process_all_videos():\n",
    "\n",
    "    records = []\n",
    "\n",
    "    video_files = [\n",
    "        p\n",
    "        for p in VIDEO_INPUT_DIR.iterdir()\n",
    "        if p.suffix.lower()\n",
    "        in VIDEO_EXTENSIONS\n",
    "    ]\n",
    "\n",
    "    print(\n",
    "        f\"Found {len(video_files)} video(s).\"\n",
    "    )\n",
    "\n",
    "    for video_path in video_files:\n",
    "\n",
    "        try:\n",
    "\n",
    "            metadata = analyze_video(\n",
    "                video_path,\n",
    "                sample_interval_seconds=1\n",
    "            )\n",
    "\n",
    "            statistics = metadata[\n",
    "                \"video_statistics\"\n",
    "            ]\n",
    "\n",
    "            video_info = metadata[\n",
    "                \"video_information\"\n",
    "            ]\n",
    "\n",
    "            records.append({\n",
    "\n",
    "                \"filename\":\n",
    "                    video_path.name,\n",
    "\n",
    "                \"media_type\":\n",
    "                    \"video\",\n",
    "\n",
    "                \"resolution\":\n",
    "                    video_info[\n",
    "                        \"resolution\"\n",
    "                    ],\n",
    "\n",
    "                \"duration_seconds\":\n",
    "                    video_info[\n",
    "                        \"duration_seconds\"\n",
    "                    ],\n",
    "\n",
    "                \"fps\":\n",
    "                    video_info[\"fps\"],\n",
    "\n",
    "                \"frames_analyzed\":\n",
    "                    metadata[\n",
    "                        \"analysis_configuration\"\n",
    "                    ][\"frames_analyzed\"],\n",
    "\n",
    "                \"average_brightness\":\n",
    "                    statistics[\n",
    "                        \"average_brightness\"\n",
    "                    ],\n",
    "\n",
    "                \"average_contrast\":\n",
    "                    statistics[\n",
    "                        \"average_contrast\"\n",
    "                    ],\n",
    "\n",
    "                \"average_sharpness\":\n",
    "                    statistics[\n",
    "                        \"average_sharpness\"\n",
    "                    ],\n",
    "\n",
    "                \"cinematic_score\":\n",
    "                    statistics[\n",
    "                        \"average_cinematic_score\"\n",
    "                    ],\n",
    "\n",
    "                \"scene_changes\":\n",
    "                    len(\n",
    "                        metadata[\n",
    "                            \"scene_changes\"\n",
    "                        ]\n",
    "                    ),\n",
    "\n",
    "                \"objects\":\n",
    "                    \", \".join(\n",
    "                        statistics[\n",
    "                            \"objects\"\n",
    "                        ].keys()\n",
    "                    )\n",
    "            })\n",
    "\n",
    "        except Exception as e:\n",
    "\n",
    "            print(\n",
    "                f\"Error processing \"\n",
    "                f\"{video_path.name}: {e}\"\n",
    "            )\n",
    "\n",
    "    df = pd.DataFrame(records)\n",
    "\n",
