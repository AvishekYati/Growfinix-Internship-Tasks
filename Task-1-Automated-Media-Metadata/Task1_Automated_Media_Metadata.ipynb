   "source": [
    "# ============================================================\n",
    "# GENERAL UTILITIES\n",
    "# ============================================================\n",
    "\n",
    "IMAGE_EXTENSIONS = {\n",
    "    \".jpg\", \".jpeg\", \".png\", \".bmp\", \".webp\", \".tif\", \".tiff\"\n",
    "}\n",
    "\n",
    "VIDEO_EXTENSIONS = {\n",
    "    \".mp4\", \".avi\", \".mov\", \".mkv\", \".webm\", \".mpeg\", \".mpg\"\n",
    "}\n",
    "\n",
    "\n",
    "def validate_media_path(path):\n",
    "    path = Path(path)\n",
    "\n",
    "    if not path.exists():\n",
    "        raise FileNotFoundError(f\"File does not exist: {path}\")\n",
    "\n",
    "    if not path.is_file():\n",
    "        raise ValueError(f\"Path is not a file: {path}\")\n",
    "\n",
    "    return path\n",
    "\n",
    "\n",
    "def get_media_type(path):\n",
    "    path = Path(path)\n",
    "    extension = path.suffix.lower()\n",
    "\n",
    "    if extension in IMAGE_EXTENSIONS:\n",
    "        return \"image\"\n",
    "\n",
    "    if extension in VIDEO_EXTENSIONS:\n",
    "        return \"video\"\n",
    "\n",
    "    return \"unknown\"\n",
    "\n",
    "\n",
    "def safe_round(value, digits=3):\n",
    "    try:\n",
    "        return round(float(value), digits)\n",
    "    except Exception:\n",
    "        return None"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "3fb6bc86-bbff-43db-a3ce-78e274d8e281",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# FILE / TECHNICAL METADATA\n",
    "# ============================================================\n",
    "\n",
    "def get_file_metadata(file_path):\n",
    "    file_path = validate_media_path(file_path)\n",
    "\n",
    "    file_size_bytes = file_path.stat().st_size\n",
    "\n",
    "    return {\n",
    "        \"filename\": file_path.name,\n",
    "        \"extension\": file_path.suffix.lower(),\n",
    "        \"file_size_bytes\": file_size_bytes,\n",
    "        \"file_size_mb\": round(file_size_bytes / (1024 ** 2), 3),\n",
    "        \"media_type\": get_media_type(file_path)\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "2e3e38f9-ab38-43c5-be9a-fe98fadb23a5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# IMAGE TECHNICAL METADATA\n",
    "# ============================================================\n",
    "\n",
    "def get_image_technical_metadata(image_path):\n",
    "    image_path = validate_media_path(image_path)\n",
    "\n",
    "    image = cv2.imread(str(image_path))\n",
    "\n",
    "    if image is None:\n",
    "        raise ValueError(f\"Unable to read image: {image_path}\")\n",
    "\n",
    "    height, width = image.shape[:2]\n",
    "\n",
    "    aspect_ratio = width / height if height else 0\n",
    "\n",
    "    return {\n",
    "        \"width\": int(width),\n",
    "        \"height\": int(height),\n",
    "        \"resolution\": f\"{width}x{height}\",\n",
    "        \"aspect_ratio\": round(aspect_ratio, 4),\n",
    "        \"channels\": int(image.shape[2])\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "25aab542-f1c3-4af4-8b69-5d858b74ac19",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# OBJECT DETECTION\n",
    "# ============================================================\n",
    "\n",
    "def detect_objects(\n",
    "    image,\n",
    "    confidence=CONFIDENCE_THRESHOLD,\n",
    "    iou=IOU_THRESHOLD\n",
    "):\n",
    "    if image is None:\n",
    "        raise ValueError(\"Input image is empty.\")\n",
    "\n",
    "    results = model.predict(\n",
    "        source=image,\n",
    "        conf=confidence,\n",
    "        iou=iou,\n",
    "        verbose=False\n",
    "    )\n",
    "\n",
    "    result = results[0]\n",
    "\n",
    "    detections = []\n",
    "\n",
    "    image_height, image_width = image.shape[:2]\n",
    "    image_area = image_width * image_height\n",
    "\n",
    "    if result.boxes is None:\n",
    "        return [], result\n",
    "\n",
    "    for box in result.boxes:\n",
    "\n",
    "        class_id = int(box.cls[0])\n",
    "        score = float(box.conf[0])\n",
    "\n",
    "        x1, y1, x2, y2 = (\n",
    "            box.xyxy[0]\n",
    "            .cpu()\n",
    "            .numpy()\n",
    "            .astype(int)\n",
    "        )\n",
    "\n",
    "        x1 = max(0, min(x1, image_width))\n",
    "        y1 = max(0, min(y1, image_height))\n",
    "        x2 = max(0, min(x2, image_width))\n",
    "        y2 = max(0, min(y2, image_height))\n",
    "\n",
    "        box_width = max(0, x2 - x1)\n",
    "        box_height = max(0, y2 - y1)\n",
    "\n",
    "        area = box_width * box_height\n",
    "\n",
    "        area_percentage = (\n",
    "            area / image_area * 100\n",
    "            if image_area > 0\n",
    "            else 0\n",
    "        )\n",
    "\n",
    "        object_name = model.names[class_id]\n",
    "\n",
    "        detections.append({\n",
    "            \"object\": object_name,\n",
    "            \"class_id\": class_id,\n",
    "            \"confidence\": round(score, 4),\n",
    "            \"confidence_level\": (\n",
    "                \"High\" if score >= 0.80\n",
    "                else \"Medium\" if score >= 0.60\n",
    "                else \"Low\"\n",
    "            ),\n",
    "            \"bbox\": {\n",
    "                \"x1\": int(x1),\n",
    "                \"y1\": int(y1),\n",
    "                \"x2\": int(x2),\n",
    "                \"y2\": int(y2)\n",
    "            },\n",
    "            \"area_percentage\": round(\n",
    "                area_percentage,\n",
    "                3\n",
    "            )\n",
    "        })\n",
    "\n",
    "    return detections, result"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "34060b9c-e9e3-4694-9117-372f9a2bc1c0",
